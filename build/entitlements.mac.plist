<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs these two to run its JavaScript engine. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Lets the app start the tools the person installed (yt-dlp, FFmpeg from Homebrew) and load Electron's own libraries. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The App Sandbox stays OFF on purpose: it would stop OPNduck from running yt-dlp and FFmpeg from Homebrew. -->
</dict>
</plist>
