{
  "name": "opnduck-desktop",
  "private": true,
  "version": "0.5.3-beta",
  "type": "module",
  "description": "OPNduck \u2014 a local-first, open-source media processing suite. Beta: downloader, converter, upscalers, subscriptions, AI audio and subtitles, plus the GUI, settings, and design system. Linux-first, Windows-parallel.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Sight8218/OPNduck",
  "author": {
    "name": "Aaron Jonsson",
    "email": "Sight8218@users.noreply.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-frame.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "desktop:dev": "node scripts/dev.mjs",
    "desktop:build": "npm run build && electron .",
    "desktop:start": "electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage pacman",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "perf": "node scripts/perf-check.mjs",
    "dist": "npm run build && electron-builder --linux AppImage pacman --win nsis portable",
    "tui:build": "node scripts/build-tui.mjs",
    "tui": "node scripts/build-tui.mjs && node dist-tui/opnduck-tui.mjs",
    "tui:pack": "node scripts/pack-tui.mjs",
    "tui:npm": "node scripts/pack-npm.mjs",
    "test": "node --test test/",
    "ai:eval": "node scripts/ai-eval.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "server:build": "node scripts/build-server.mjs",
    "server": "node scripts/build-server.mjs && node dist-server/opnduck-server.cjs",
    "dist:mac": "npm run build && electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "dev.opnduck.desktop",
    "productName": "OPNduck",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "engine-api/**/*",
      "!electron/**/__pycache__"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "pacman"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronLanguages": [
      "en-US"
    ],
    "protocols": [
      {
        "name": "OPNduck",
        "schemes": [
          "opnduck"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "-"
    },
    "dmg": {
      "title": "OPNduck ${version}"
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "framer-motion": "^14.1.0",
    "ink": "^8.0.0",
    "oxlint": "^1.87.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "electron/main.cjs"
}
