{
  "name": "opnduck-desktop",
  "private": true,
  "version": "0.2.0-pre-alpha",
  "type": "module",
  "description": "OPNduck — a local-first, open-source media processing suite. Pre-Alpha shell: GUI, settings, and design system. Linux-first, Windows-parallel.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Sight8218/OPNduck",
  "author": {
    "name": "Aaron Jonsson",
    "email": "Sight8218@users.noreply.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://localhost:1420 && electron .\"",
    "desktop:build": "npm run build && electron .",
    "desktop:start": "electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage pacman",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist": "npm run build && electron-builder --linux AppImage pacman --win nsis portable"
  },
  "build": {
    "appId": "dev.opnduck.desktop",
    "productName": "OPNduck",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "target": ["AppImage", "pacman"]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs"
}
