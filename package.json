{
  "name": "opnduck-desktop",
  "private": true,
  "version": "0.2.0-pre-alpha",
  "type": "module",
  "description": "OPNduck — a local-first, open-source media processing suite. Pre-Alpha shell: GUI, settings, and design system. Linux-first, Windows-parallel.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://localhost:1420 && electron .\"",
    "desktop:build": "npm run build && electron .",
    "desktop:start": "electron ."
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs"
}
